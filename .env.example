# ChurchFlow Environment Configuration Example
PORT=3030
NODE_ENV=production

# Database Credentials
DB_HOST=db
DB_PORT=5432
DB_USER=servesync
DB_PASSWORD=your_secure_db_password
DB_NAME=servesync

# Security & JWT Secrets
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key

# Main Admin Credentials (used for bootstrap & management)
ADMIN_USERNAME=Isaac
ADMIN_PASSWORD=your_admin_password
ADMIN_EMAIL=isaac@yourchurch.org

# Optional Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=
